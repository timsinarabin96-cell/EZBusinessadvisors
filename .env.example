# ---------------------------------------------------------------------------
# Concord Deal Platform — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service-role key (bypasses RLS for queues/admin flows)
SUPABASE_SERVICE_ROLE_KEY=

# Claude / AI Agents
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash

# --- Email (optional: enables real delivery via SMTP) ---
# When unset, emails are queued to the email_emails table instead.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CONCORD Deal Platform <no-reply@ezbusinessadvisors.com>

# --- Social Media Integration (optional: for auto-posting) ---
# Facebook & Instagram share one Graph app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# TikTok developer app (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# X (Twitter) developer app (API v2)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Public callback URL, e.g. https://your-domain.com/api/social/callback
REDIRECT_URI=

# Stripe (optional, billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# BizBuySell (optional, listing sync)
BIZBUYSELL_WEBHOOK_SECRET=

# Calendar (optional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
RESET_TOKEN_EXPIRY=3600
VOICE_AGENT_WEBHOOK_SECRET=
VOICE_AGENT_AGENCY_ID=

# --- AI Phone Agent (Twilio) ---
VOICE_AGENT_WEBHOOK_SECRET=change-me
VOICE_AGENT_AGENCY_ID=
VOICE_AGENT_AGENCY_NAME=Your Brokerage
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
